# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# NOTE: DASHSCOPE_API_KEY is deliberately NOT listed here as a .env entry.
# It is configured as a system environment variable on the development machine
# (see CLAUDE.md, 语言模型配置). The loader reads it from the process
# environment either way; putting it in .env is allowed but not required.

# BEA API key, free registration at https://apps.bea.gov/API/signup/
# Used by M1 to pull Regional Price Parities.
BEA_API_KEY=your_bea_key_here
