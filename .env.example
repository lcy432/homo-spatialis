# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Required only for real Qwen model calls; offline mock runs need no key.
# The full-run launcher loads .env without overriding existing environment variables.
# If you use an environment variable instead, remove the matching placeholder below.
# Keep only one value per key; conflicting values are rejected during model setup.
# Default endpoint: Alibaba Cloud Model Studio, China (Beijing).
# Your key, endpoint, and model must belong to the same region.
# Setup: docs/REPRODUCING.en.md#real-models (Chinese: docs/REPRODUCING.md#real-models).
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Optional: only for fetching BEA data, not for running the bundled city packs.
# Free registration: https://apps.bea.gov/API/signup/
BEA_API_KEY=your_bea_key_here
