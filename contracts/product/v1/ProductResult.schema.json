{
 "$defs": {
  "CityResult": {
   "additionalProperties": false,
   "description": "一座城的结果：原计划 N = C + E + M；完整者均值的分母是 C；模拟缺失范围的分母是 C + M（出局者不进）。空值保持为空。",
   "properties": {
    "city_ref": {
     "title": "City Ref",
     "type": "string"
    },
    "complete": {
     "title": "Complete",
     "type": "integer"
    },
    "exit_share": {
     "$ref": "#/$defs/ExactNumber"
    },
    "exits": {
     "title": "Exits",
     "type": "integer"
    },
    "hard_requirements": {
     "default": [],
     "items": {
      "$ref": "#/$defs/RequirementSummaryLine"
     },
     "title": "Hard Requirements",
     "type": "array"
    },
    "headline_zh": {
     "title": "Headline Zh",
     "type": "string"
    },
    "label": {
     "title": "Label",
     "type": "string"
    },
    "mean_denominator": {
     "title": "Mean Denominator",
     "type": "integer"
    },
    "mean_j": {
     "anyOf": [
      {
       "$ref": "#/$defs/ExactNumber"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "mean_l": {
     "anyOf": [
      {
       "$ref": "#/$defs/ExactNumber"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "mean_v": {
     "anyOf": [
      {
       "$ref": "#/$defs/ExactNumber"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "missing": {
     "title": "Missing",
     "type": "integer"
    },
    "missing_reasons": {
     "default": [],
     "items": {
      "$ref": "#/$defs/MissingReasonLine"
     },
     "title": "Missing Reasons",
     "type": "array"
    },
    "missing_share": {
     "$ref": "#/$defs/ExactNumber"
    },
    "notes_zh": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Notes Zh",
     "type": "array"
    },
    "planned": {
     "title": "Planned",
     "type": "integer"
    },
    "range_denominator": {
     "title": "Range Denominator",
     "type": "integer"
    },
    "range_lower": {
     "anyOf": [
      {
       "$ref": "#/$defs/ExactNumber"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "range_upper": {
     "anyOf": [
      {
       "$ref": "#/$defs/ExactNumber"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "required": [
    "city_ref",
    "label",
    "planned",
    "complete",
    "exits",
    "missing",
    "mean_denominator",
    "range_denominator",
    "exit_share",
    "missing_share",
    "headline_zh"
   ],
   "title": "CityResult",
   "type": "object"
  },
