  "DataPackRef": {
   "additionalProperties": false,
   "description": "一份资料包的身份：编号与内容指纹。本轮只有合成资料包（``synthetic_fixture_only``）。",
   "properties": {
    "content_fingerprint": {
     "pattern": "^[0-9a-f]{64}$",
     "title": "Content Fingerprint",
     "type": "string"
    },
    "note": {
     "maxLength": 400,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "pack_id": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$",
     "title": "Pack Id",
     "type": "string"
    },
    "status": {
     "enum": [
      "synthetic_fixture_only",
      "real_data_frozen"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "pack_id",
    "content_fingerprint",
    "status",
    "note"
   ],
   "title": "DataPackRef",
   "type": "object"
  },
  "ExactNumber": {
   "additionalProperties": false,
   "description": "一个精确数：``exact`` 是规范分数写法（参与计算与比较），``display`` 只供显示（四舍五入，不回流计算）。",
   "properties": {
    "display": {
     "maxLength": 40,
     "minLength": 1,
     "title": "Display",
     "type": "string"
    },
    "exact": {
     "pattern": "^(0|-?[1-9][0-9]*)(/[1-9][0-9]*)?$",
     "title": "Exact",
     "type": "string"
    }
   },
   "required": [
    "exact",
    "display"
   ],
   "title": "ExactNumber",
   "type": "object"
  },
  "HouseholdHours": {
   "additionalProperties": false,
   "description": "本人每月实际做的家务小时（资源账的事实，精确值）。",
   "properties": {
    "monthly_hours": {
     "items": {
      "type": "string"
     },
     "title": "Monthly Hours",
     "type": "array"
    },
    "task": {
     "title": "Task",
     "type": "string"
    }
   },
   "required": [
