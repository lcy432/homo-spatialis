{
 "$defs": {
  "BuildCount": {
   "additionalProperties": false,
   "description": "资料包构建报告里的一个计数（片区、通勤线、住房候选与排除的原因、放进目录的岗位、菜单……）。",
   "properties": {
    "count": {
     "minimum": 0,
     "title": "Count",
     "type": "integer"
    },
    "key": {
     "maxLength": 64,
     "minLength": 1,
     "title": "Key",
     "type": "string"
    },
    "label_zh": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Label Zh",
     "type": "string"
    }
   },
   "required": [
    "key",
    "label_zh",
    "count"
   ],
   "title": "BuildCount",
   "type": "object"
  },
  "CapabilityStatus": {
   "additionalProperties": false,
   "description": "一种能力在当前输入与声明范围内的状态。**不保证**未来每份计划都合法、每个月都能完整评分。",
   "properties": {
    "reasons": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Reasons",
     "type": "array"
    },
    "status": {
     "enum": [
      "yes",
      "no",
      "partial",
      "unknown"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "status"
   ],
   "title": "CapabilityStatus",
   "type": "object"
  },
  "CategorySources": {
   "additionalProperties": false,
   "description": "目录里一类机会（住房、岗位、食品、服务……）的条数，按来源性质分开数（四种性质都列，没有的写 0）。",
   "properties": {
    "by_kind": {
     "items": {
      "$ref": "#/$defs/SourceKindCount"
     },
     "maxItems": 4,
     "minItems": 4,
     "title": "By Kind",
     "type": "array"
    },
    "category": {
     "maxLength": 48,
     "minLength": 1,
     "title": "Category",
     "type": "string"
    },
    "total": {
     "minimum": 0,
     "title": "Total",
     "type": "integer"
    }
   },
   "required": [
    "category",
    "total",
    "by_kind"
   ],
   "title": "CategorySources",
   "type": "object"
  },
  "CityCoverageSummary": {
   "additionalProperties": false,
   "description": "一座城的偏好覆盖摘要（E1 覆盖报告的投影）。不是阈值，也不解锁不完整的总分。\n\n* ``common_weight``：整个比较组**共同**覆盖的权重（每座城资料都齐、规则都有的叶子之和；各城相同，城市比较只在这部分上是同口径的）；\n* ``unknown_weight``：**这座城**资料未知的正权重之和（这些月份的总分会不完整，不补 0、不删掉再重新归一化）；\n* ``no_component_weight``：本版评分没有分项的正权重之和（各城相同）；\n* ``unsupported_positive_leaves``：**这座城**资料未知或没有评分分项的正权重叶子。",
   "properties": {
    "common_weight": {
     "$ref": "#/$defs/ExactNumber"
    },
    "label": {
     "title": "Label",
     "type": "string"
    },
    "no_component_weight": {
     "$ref": "#/$defs/ExactNumber"
    },
    "unknown_weight": {
     "$ref": "#/$defs/ExactNumber"
    },
    "unsupported_positive_leaves": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Unsupported Positive Leaves",
     "type": "array"
    }
   },
   "required": [
    "common_weight",
    "unknown_weight",
    "no_component_weight",
    "label"
   ],
   "title": "CityCoverageSummary",
   "type": "object"
  },
  "CityDataNature": {
   "additionalProperties": false,
   "description": "一座城的资料是怎么来的（DECISIONS/0042）：目录各类机会按来源性质的条数、登记的模型设定、共同先验、治疗的共同假设、\n模型活动设定、片区、通勤方式、菜单、税的范围，以及资料包构建报告的计数。\n\n只有公开的来源性质与说明：没有评分参数（η、τ、c、背景量）、抽签或内部状态。``build_status = not_available`` 表示构建报告\n不在这份资料包里或与目录对不上——计数未知，不是 0。",
   "properties": {
    "build": {
     "default": [],
     "items": {
      "$ref": "#/$defs/BuildCount"
     },
     "title": "Build",
     "type": "array"
    },
    "build_status": {
     "enum": [
      "from_pack_report",
      "not_available"
     ],
     "title": "Build Status",
     "type": "string"
    },
    "city_ref": {
     "title": "City Ref",
     "type": "string"
    },
    "common_priors": {
     "default": [],
     "items": {
      "$ref": "#/$defs/CommonPrior"
     },
     "title": "Common Priors",
     "type": "array"
    },
    "commute_modes": {
     "default": [],
     "items": {
      "$ref": "#/$defs/CommuteModeAvailability"
     },
     "title": "Commute Modes",
     "type": "array"
    },
    "home_areas": {
     "default": 0,
     "minimum": 0,
     "title": "Home Areas",
     "type": "integer"
    },
    "label": {
     "title": "Label",
     "type": "string"
    },
    "menus": {
     "default": [],
     "items": {
      "$ref": "#/$defs/MenuSummary"
     },
     "title": "Menus",
     "type": "array"
    },
    "model_plan_activities": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Model Plan Activities",
     "type": "array"
    },
    "named_assumptions": {
     "default": [],
     "items": {
      "$ref": "#/$defs/NamedAssumption"
     },
     "title": "Named Assumptions",
     "type": "array"
    },
    "opportunities": {
     "default": [],
     "items": {
      "$ref": "#/$defs/CategorySources"
     },
     "title": "Opportunities",
     "type": "array"
    },
    "pack_status": {
     "enum": [
      "synthetic_fixture_only",
      "real_data_frozen"
     ],
     "title": "Pack Status",
     "type": "string"
    },
    "summary_zh": {
     "maxLength": 400,
     "minLength": 1,
     "title": "Summary Zh",
     "type": "string"
    },
    "tax": {
     "anyOf": [
      {
       "$ref": "#/$defs/TaxScope"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "totals": {
     "items": {
      "$ref": "#/$defs/SourceKindCount"
     },
     "maxItems": 4,
     "minItems": 4,
     "title": "Totals",
     "type": "array"
    },
    "treatment_assumptions_zh": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Treatment Assumptions Zh",
     "type": "array"
    },
    "work_areas": {
     "default": 0,
     "minimum": 0,
     "title": "Work Areas",
     "type": "integer"
    }
   },
   "required": [
    "city_ref",
    "label",
    "pack_status",
    "summary_zh",
    "totals",
    "build_status"
   ],
   "title": "CityDataNature",
   "type": "object"
  },
  "CityPreflight": {
   "additionalProperties": false,
   "properties": {
    "city_ref": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$",
     "title": "City Ref",
     "type": "string"
    },
    "coverage": {
     "anyOf": [
      {
       "$ref": "#/$defs/CityCoverageSummary"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "data_gaps": {
     "default": [],
     "items": {
      "$ref": "#/$defs/ProductIssue"
     },
     "title": "Data Gaps",
     "type": "array"
    },
    "data_nature": {
     "anyOf": [
      {
       "$ref": "#/$defs/CityDataNature"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "executable": {
     "$ref": "#/$defs/CapabilityStatus"
    },
    "feedback": {
     "$ref": "#/$defs/CapabilityStatus"
    },
    "label": {
     "title": "Label",
     "type": "string"
    },
    "option_inventory_status": {
     "enum": [
      "complete_for_declared_scope",
      "partial",
      "not_assessed"
     ],
     "title": "Option Inventory Status",
     "type": "string"
    },
    "scorable": {
     "$ref": "#/$defs/CapabilityStatus"
    },
    "start_job_label": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Start Job Label"
    }
   },
   "required": [
    "city_ref",
    "label",
    "executable",
    "scorable",
    "feedback",
    "option_inventory_status"
   ],
   "title": "CityPreflight",
   "type": "object"
  },
  "CloneProgress": {
   "additionalProperties": false,
   "properties": {
    "city_ref": {
     "title": "City Ref",
     "type": "string"
    },
    "clone_ref": {
     "title": "Clone Ref",
     "type": "string"
    },
    "status": {
     "title": "Status",
     "type": "string"
    },
    "status_zh": {
     "title": "Status Zh",
     "type": "string"
    },
    "years_committed": {
     "minimum": 0,
     "title": "Years Committed",
     "type": "integer"
    }
   },
   "required": [
    "clone_ref",
    "city_ref",
    "status",
    "status_zh",
    "years_committed"
   ],
   "title": "CloneProgress",
   "type": "object"
  },
  "CommonPrior": {
   "additionalProperties": false,
   "description": "一项比较组各城共用的背景设定（没有可比资料时登记的共同先验，例如休闲；安全按各都会区的犯罪资料换算，不在这里）：事实的\n名称与含义。不制造城市差异；\n这里不写它换算成评分输入的规则与参数。",
   "properties": {
    "fact_id": {
     "maxLength": 64,
     "minLength": 1,
     "title": "Fact Id",
     "type": "string"
    },
    "label": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Label",
     "type": "string"
    },
    "meaning_zh": {
     "maxLength": 400,
     "minLength": 1,
     "title": "Meaning Zh",
     "type": "string"
    }
   },
   "required": [
    "fact_id",
    "label",
    "meaning_zh"
   ],
   "title": "CommonPrior",
   "type": "object"
  },
  "CommuteModeAvailability": {
   "additionalProperties": false,
   "description": "这座城的通勤关系表里有没有一种方式：有几条片区之间的线、使用条件与封顶的说明（与给分身看的同一份公开说明）。\n\n``in_relation = False``：关系表里没有这种方式（资料缺失或本城不建模），到岗时不能用它——不当 0 分钟，也不当免费。",
   "properties": {
    "condition_zh": {
     "anyOf": [
      {
       "maxLength": 400,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Condition Zh"
    },
    "in_relation": {
     "title": "In Relation",
     "type": "boolean"
    },
    "lines": {
     "minimum": 0,
     "title": "Lines",
     "type": "integer"
    },
    "mode": {
     "enum": [
      "walk_bike",
      "transit",
      "drive"
     ],
     "title": "Mode",
     "type": "string"
    },
    "mode_zh": {
     "maxLength": 20,
     "minLength": 1,
     "title": "Mode Zh",
     "type": "string"
    }
   },
   "required": [
    "mode",
    "mode_zh",
    "in_relation",
    "lines"
   ],
   "title": "CommuteModeAvailability",
   "type": "object"
  },
  "ConfirmedRef": {
   "additionalProperties": false,
   "properties": {
    "confirmed_id": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$",
     "title": "Confirmed Id",
     "type": "string"
    },
    "content_fingerprint": {
     "pattern": "^[0-9a-f]{64}$",
     "title": "Content Fingerprint",
     "type": "string"
    }
   },
   "required": [
    "confirmed_id",
    "content_fingerprint"
   ],
   "title": "ConfirmedRef",
   "type": "object"
  },
  "CostStatus": {
   "additionalProperties": false,
   "description": "费用状态：离线 mock 为零；真实模型只能写“按报价估算”，以供应商账单为准。\n\n``calls_used`` / ``call_limit`` 数的是**规划候选**（每个分身每年一次正常规划、最多两次修订）；``service_attempts`` 数的是实际发给\n服务的尝试（每份候选最多再试一次服务请求），两者不是同一个计数。金额都是应用侧按已记录报价估算（E3C）：``settled_cost`` 是返回了\n用量、已核算的；``uncertain_cost`` 是请求可能已经发出、用量不确定、按预留保留的（不改成 0）；``in_flight_cost`` 是已经预留、还没有\n结果的；``estimated_cost`` 是三者之和。``max_cost`` 是这次运行的应用侧上限，不是供应商的账单上限。",
   "properties": {
    "call_limit": {
     "minimum": 0,
     "title": "Call Limit",
     "type": "integer"
    },
    "calls_used": {
     "minimum": 0,
     "title": "Calls Used",
     "type": "integer"
    },
    "currency": {
     "anyOf": [
      {
       "enum": [
        "CNY",
        "USD"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Currency"
    },
    "estimated_cost": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Estimated Cost"
    },
    "in_flight_cost": {
     "anyOf": [
      {
       "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "In Flight Cost"
    },
    "kind": {
     "enum": [
      "offline_mock_zero_cost",
      "estimated_from_quote"
     ],
     "title": "Kind",
     "type": "string"
    },
    "max_cost": {
     "anyOf": [
      {
       "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Max Cost"
    },
    "note": {
     "title": "Note",
     "type": "string"
    },
    "price_version": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Price Version"
    },
    "service_attempt_limit": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Service Attempt Limit"
    },
    "service_attempts": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Service Attempts"
    },
    "settled_cost": {
     "anyOf": [
      {
       "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Settled Cost"
    },
    "uncertain_attempts": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Uncertain Attempts"
    },
    "uncertain_cost": {
     "anyOf": [
      {
       "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Uncertain Cost"
    }
   },
   "required": [
    "kind",
    "calls_used",
    "call_limit",
    "note"
   ],
   "title": "CostStatus",
   "type": "object"
  },
  "DataPackRef": {
   "additionalProperties": false,
   "description": "一份资料包的身份：编号、内容指纹与状态（合成测试资料，或冻结的真实资料包）。",
   "properties": {
    "content_fingerprint": {
     "pattern": "^[0-9a-f]{64}$",
     "title": "Content Fingerprint",
     "type": "string"
    },
    "note": {
     "maxLength": 400,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "pack_id": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$",
     "title": "Pack Id",
     "type": "string"
    },
    "status": {
     "enum": [
      "synthetic_fixture_only",
      "real_data_frozen"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "pack_id",
    "content_fingerprint",
    "status",
    "note"
   ],
   "title": "DataPackRef",
   "type": "object"
  },
  "DeletionState": {
   "additionalProperties": false,
   "properties": {
    "completed_at": {
     "anyOf": [
      {
       "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Completed At"
    },
    "requested_at": {
     "anyOf": [
      {
       "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Requested At"
    },
    "state": {
     "enum": [
      "none",
      "deleting",
      "deleted"
     ],
     "title": "State",
     "type": "string"
    }
   },
   "required": [
    "state"
   ],
   "title": "DeletionState",
   "type": "object"
  },
  "ExactNumber": {
   "additionalProperties": false,
   "description": "一个精确数：``exact`` 是规范分数写法（参与计算与比较），``display`` 只供显示（四舍五入，不回流计算）。",
   "properties": {
    "display": {
     "maxLength": 40,
     "minLength": 1,
     "title": "Display",
     "type": "string"
    },
    "exact": {
     "pattern": "^(0|-?[1-9][0-9]*)(/[1-9][0-9]*)?$",
     "title": "Exact",
     "type": "string"
    }
   },
   "required": [
    "exact",
    "display"
   ],
   "title": "ExactNumber",
   "type": "object"
  },
  "MenuSummary": {
   "additionalProperties": false,
   "description": "一类机会的年度菜单（DECISIONS/0042）：每年、每个环境重复给分身看的一份抽样。菜单是接触机会，不是成交或录用。",
   "properties": {
    "category": {
     "maxLength": 48,
     "minLength": 1,
     "title": "Category",
     "type": "string"
    },
    "env_repeats": {
     "minimum": 1,
     "title": "Env Repeats",
     "type": "integer"
    },
    "items_max": {
     "minimum": 1,
     "title": "Items Max",
     "type": "integer"
    },
    "items_min": {
     "minimum": 1,
     "title": "Items Min",
     "type": "integer"
    },
    "years": {
     "minimum": 1,
     "title": "Years",
     "type": "integer"
    }
   },
   "required": [
    "category",
    "years",
    "env_repeats",
    "items_min",
    "items_max"
   ],
   "title": "MenuSummary",
   "type": "object"
  },
  "NamedAssumption": {
   "additionalProperties": false,
   "description": "一条登记的模型设定（来源性质是合成）：设定说明的原文、用到它的机会条数与几个例子。不是资料，也不是某个商品或场所的报价。",
   "properties": {
    "count": {
     "minimum": 1,
     "title": "Count",
     "type": "integer"
    },
    "examples": {
     "items": {
      "type": "string"
     },
     "maxItems": 3,
     "minItems": 1,
     "title": "Examples",
     "type": "array"
    },
    "note_zh": {
     "maxLength": 400,
     "minLength": 1,
     "title": "Note Zh",
     "type": "string"
    }
   },
   "required": [
    "note_zh",
    "count",
    "examples"
   ],
   "title": "NamedAssumption",
   "type": "object"
  },
  "PlannerAndCost": {
   "additionalProperties": false,
   "properties": {
