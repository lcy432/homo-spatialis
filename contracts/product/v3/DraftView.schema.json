{
 "$defs": {
  "AbilityClaim": {
   "additionalProperties": false,
   "description": "用户自己确认的一项资格事实（只在相关岗位需要时追问；不从职称推断）。",
   "properties": {
    "ability_id": {
     "maxLength": 48,
     "minLength": 1,
     "title": "Ability Id",
     "type": "string"
    },
    "state": {
     "enum": [
      "unanswered",
      "provided",
      "indifferent",
      "unsure"
     ],
     "title": "State",
     "type": "string"
    }
   },
   "required": [
    "ability_id",
    "state"
   ],
   "title": "AbilityClaim",
   "type": "object"
  },
  "AgeAnswer": {
   "additionalProperties": false,
   "properties": {
    "state": {
     "enum": [
      "unanswered",
      "provided",
      "indifferent",
      "unsure"
     ],
     "title": "State",
     "type": "string"
    },
    "value": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Value"
    }
   },
   "required": [
    "state"
   ],
   "title": "AgeAnswer",
   "type": "object"
  },
  "AllocationAnswer": {
   "additionalProperties": false,
   "description": "一组定和分配的作答。``mode = equal_split`` 表示用户**主动**选择了平均分配（不预选、不默认）；``None`` 表示还没开始分配。\n``ratings_normalized_v1``：独立评分（未答不是 0；“同等重视”由用户主动把每项设为 50）。",
   "properties": {
    "entries": {
     "additionalProperties": {
      "$ref": "#/$defs/PointEntry"
     },
     "title": "Entries",
     "type": "object"
    },
    "mode": {
     "anyOf": [
      {
       "enum": [
        "manual",
        "equal_split",
        "ratings_normalized_v1"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Mode"
    }
   },
   "title": "AllocationAnswer",
   "type": "object"
  },
  "AttributePreferenceAnswer": {
   "additionalProperties": false,
   "description": "一条属性偏好（品牌、菜系、上门顾虑……）：原文与它挂在哪项需求下；``as_hard_requirement`` 表示用户想把它当不可妥协的要求。",
   "properties": {
    "as_hard_requirement": {
     "default": false,
     "title": "As Hard Requirement",
     "type": "boolean"
    },
    "kind": {
     "maxLength": 48,
     "minLength": 1,
     "title": "Kind",
     "type": "string"
    },
    "need": {
     "maxLength": 48,
     "minLength": 1,
     "title": "Need",
     "type": "string"
    },
    "preference_id": {
     "pattern": "^[a-z][a-z0-9_.]{1,63}$",
     "title": "Preference Id",
     "type": "string"
    },
    "raw_text": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Raw Text",
     "type": "string"
    }
   },
   "required": [
    "preference_id",
    "need",
    "kind",
    "raw_text"
   ],
   "title": "AttributePreferenceAnswer",
   "type": "object"
  },
  "CashAnswer": {
   "additionalProperties": false,
   "description": "开始时可用于生活的流动资金：金额文字、币种、金额时期与口径（不是总资产、信用额度或月薪）。",
   "properties": {
    "amount_text": {
     "anyOf": [
      {
       "maxLength": 40,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Amount Text"
    },
    "currency": {
     "anyOf": [
      {
       "maxLength": 3,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Currency"
    },
    "meaning": {
     "const": "liquid_funds_v1",
     "default": "liquid_funds_v1",
     "title": "Meaning",
     "type": "string"
    },
    "price_period": {
     "anyOf": [
      {
       "maxLength": 20,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Price Period"
    },
    "state": {
     "enum": [
      "unanswered",
      "provided",
      "indifferent",
      "unsure"
     ],
     "title": "State",
     "type": "string"
    }
   },
   "required": [
    "state"
   ],
   "title": "CashAnswer",
   "type": "object"
  },
  "CertificatesAnswer": {
   "additionalProperties": false,
   "description": "职业证书（多选）：``provided`` 加选中的资格编号；**明确提交空列表表示“没有”**，与未答分开保存。",
   "properties": {
    "selected": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Selected",
     "type": "array"
    },
    "state": {
     "default": "unanswered",
     "enum": [
      "unanswered",
      "provided",
      "unsure"
     ],
     "title": "State",
     "type": "string"
    }
   },
   "title": "CertificatesAnswer",
   "type": "object"
  },
  "CitiesAnswer": {
   "additionalProperties": false,
   "properties": {
    "city_refs": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "City Refs",
     "type": "array"
    },
    "state": {
     "enum": [
      "unanswered",
      "provided",
      "indifferent",
      "unsure"
     ],
     "title": "State",
     "type": "string"
    }
   },
   "required": [
    "state"
   ],
   "title": "CitiesAnswer",
   "type": "object"
  },
  "DataPackRef": {
   "additionalProperties": false,
   "description": "一份资料包的身份：编号、内容指纹与状态（合成测试资料，或冻结的真实资料包）。",
   "properties": {
    "content_fingerprint": {
     "pattern": "^[0-9a-f]{64}$",
     "title": "Content Fingerprint",
     "type": "string"
    },
    "note": {
     "maxLength": 400,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "pack_id": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$",
     "title": "Pack Id",
     "type": "string"
    },
    "status": {
     "enum": [
      "synthetic_fixture_only",
      "real_data_frozen"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "pack_id",
    "content_fingerprint",
    "status",
    "note"
   ],
   "title": "DataPackRef",
   "type": "object"
  },
  "EducationAnswer": {
   "additionalProperties": false,
   "description": "最高学历（单选）：未答、暂不确定，或选了输入目录里的一个选项。只有选了才授予学历门槛。",
   "properties": {
    "option_id": {
     "anyOf": [
      {
       "maxLength": 48,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Option Id"
    },
    "state": {
     "default": "unanswered",
     "enum": [
      "unanswered",
      "provided",
      "unsure"
     ],
     "title": "State",
     "type": "string"
    }
   },
   "title": "EducationAnswer",
   "type": "object"
  },
  "EvidenceRef": {
   "additionalProperties": false,
   "description": "答案的来源证据：本轮只有表单字段；未来访谈的记录引用在这里接入（访谈 → 候选解释 → 确认 → 同一编译器）。",
   "properties": {
    "kind": {
     "enum": [
      "form_field",
      "interview_turn_reserved"
     ],
     "title": "Kind",
     "type": "string"
    },
    "note": {
     "anyOf": [
      {
       "maxLength": 300,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Note"
    },
    "ref": {
     "maxLength": 160,
     "minLength": 1,
     "title": "Ref",
     "type": "string"
    }
   },
   "required": [
    "kind",
    "ref"
   ],
   "title": "EvidenceRef",
   "type": "object"
  },
  "ExperienceAnswer": {
   "additionalProperties": false,
   "description": "相关工作经验（只在选中的职业需要时问）：``provided`` 加经历；明确提交空列表表示“没有相关经验”，与未答分开保存。",
   "properties": {
    "entries": {
     "default": [],
     "items": {
      "$ref": "#/$defs/ExperienceEntry"
     },
     "title": "Entries",
     "type": "array"
    },
    "state": {
     "default": "unanswered",
     "enum": [
      "unanswered",
      "provided",
      "unsure"
     ],
     "title": "State",
     "type": "string"
    }
   },
   "title": "ExperienceAnswer",
   "type": "object"
  },
  "ExperienceEntry": {
   "additionalProperties": false,
   "description": "一段相关工作经历：职业概念（输入目录里经验问题列出的相关职业）与整年数。",
   "properties": {
    "concept_id": {
     "pattern": "^[a-z][a-z0-9_.]{1,79}$",
     "title": "Concept Id",
     "type": "string"
    },
    "years": {
     "maximum": 60,
     "minimum": 0,
     "title": "Years",
     "type": "integer"
    }
   },
   "required": [
    "concept_id",
    "years"
   ],
   "title": "ExperienceEntry",
   "type": "object"
  },
  "FreeTextAnswer": {
   "additionalProperties": false,
   "description": "可选文字。超过 2,000 字符**不截断**：校验时报错，由用户自己删减。",
   "properties": {
    "state": {
     "enum": [
      "unanswered",
      "provided",
      "indifferent",
      "unsure"
     ],
     "title": "State",
     "type": "string"
    },
    "text": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Text"
    }
   },
   "required": [
    "state"
   ],
   "title": "FreeTextAnswer",
   "type": "object"
  },
  "HardRequirementAnswer": {
   "additionalProperties": false,
   "description": "一条硬要求：选了受支持的选项（带参数），或只写了原文（本版未支持，只留存）。",
   "properties": {
    "option_id": {
     "anyOf": [
      {
       "maxLength": 64,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Option Id"
    },
    "parameter_value": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Parameter Value"
    },
    "raw_text": {
     "anyOf": [
      {
       "maxLength": 300,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Raw Text"
    },
    "requirement_id": {
     "pattern": "^[a-z][a-z0-9_.]{1,63}$",
     "title": "Requirement Id",
     "type": "string"
    }
   },
   "required": [
    "requirement_id"
   ],
   "title": "HardRequirementAnswer",
   "type": "object"
  },
  "HealthAnswers": {
   "additionalProperties": false,
   "properties": {
    "items": {
     "default": [],
     "items": {
      "$ref": "#/$defs/HealthItemAnswer"
     },
     "title": "Items",
     "type": "array"
    },
    "questionnaire_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Questionnaire Version",
     "type": "string"
    }
   },
   "required": [
    "questionnaire_version"
   ],
   "title": "HealthAnswers",
   "type": "object"
  },
  "HealthItemAnswer": {
   "additionalProperties": false,
   "description": "一题的作答：四个选项之一；``None`` = 未答（与“暂不确定”分开保存）。",
   "properties": {
    "choice": {
     "anyOf": [
      {
       "enum": [
        "agree",
        "disagree",
        "no_clear_tendency",
        "unsure"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Choice"
    },
    "question_id": {
     "maxLength": 48,
     "minLength": 1,
     "title": "Question Id",
     "type": "string"
    }
   },
   "required": [
    "question_id"
   ],
   "title": "HealthItemAnswer",
   "type": "object"
  },
  "LeisureInterestAnswer": {
   "additionalProperties": false,
   "description": "休闲兴趣：未答、暂不确定、明确没有固定爱好、选择通用休闲评价（“城市有什么合适的就体验什么”），或用文字描述。\n\n文字描述先由 E3 按词表形成待确认的解释；``selected`` 是用户从解释或词表里**明确选中**的类别——只有选了才进入有评分作用的类别。\n空白不会被当成“通用评价”的选择。",
   "properties": {
    "selected": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Selected",
     "type": "array"
    },
    "state": {
     "default": "unanswered",
     "enum": [
      "unanswered",
      "unsure",
      "no_fixed_hobby",
      "generic",
      "described",
      "selected"
     ],
     "title": "State",
     "type": "string"
    },
    "text": {
     "anyOf": [
      {
       "maxLength": 300,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Text"
    }
   },
   "title": "LeisureInterestAnswer",
   "type": "object"
  },
  "OccupationAnswer": {
   "additionalProperties": false,
   "description": "职业。``mode = catalog``（新流程）：从输入目录直接选中的概念编号与那份目录的版本、内容身份，不需要也不保存任何文字（搜索框\n里的字只是查找条件）。``mode = text``（兼容）：原文与语言，再在少量候选里选中一个。概念编号不透明，不是职业代码。",
   "properties": {
    "catalog_fingerprint": {
     "anyOf": [
      {
       "pattern": "^[0-9a-f]{64}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Catalog Fingerprint"
    },
    "catalog_version": {
     "anyOf": [
      {
       "maxLength": 80,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Catalog Version"
    },
    "language": {
     "default": "zh",
     "maxLength": 10,
     "minLength": 2,
     "title": "Language",
     "type": "string"
    },
    "mode": {
     "default": "text",
     "enum": [
      "text",
      "catalog"
     ],
     "title": "Mode",
     "type": "string"
    },
    "raw_text": {
     "anyOf": [
      {
       "maxLength": 300,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Raw Text"
    },
    "selected_candidate": {
     "anyOf": [
      {
       "maxLength": 80,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Selected Candidate"
    },
    "state": {
     "enum": [
      "unanswered",
      "provided",
      "indifferent",
      "unsure"
     ],
     "title": "State",
     "type": "string"
    }
   },
   "required": [
    "state"
   ],
   "title": "OccupationAnswer",
   "type": "object"
  },
  "PointEntry": {
   "additionalProperties": false,
   "description": "一个维度或细项的作答：已提供时写数值文字（精确十进制或规范分数），其余状态不写数值。明确 0 写 ``\"0\"``。",
   "properties": {
    "state": {
     "enum": [
      "unanswered",
      "provided",
      "indifferent",
      "unsure"
     ],
     "title": "State",
     "type": "string"
    },
    "value_text": {
     "anyOf": [
      {
       "maxLength": 40,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Value Text"
    }
   },
   "required": [
    "state"
   ],
   "title": "PointEntry",
   "type": "object"
  },
  "ProductMeta": {
   "additionalProperties": false,
   "description": "每条产品消息都带的共同元数据：结构、问卷、词表、健康问卷、转换的版本与资料包身份。",
   "properties": {
    "conversion_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Conversion Version",
     "type": "string"
    },
    "data_pack": {
     "$ref": "#/$defs/DataPackRef"
    },
    "health_questionnaire_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Health Questionnaire Version",
     "type": "string"
    },
    "questionnaire_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Questionnaire Version",
     "type": "string"
    },
    "sample": {
     "anyOf": [
      {
       "$ref": "#/$defs/SampleLabel"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "schema_version": {
     "enum": [
      "e3a-product-schema-v3.3",
      "e3a-product-schema-v3.4",
      "e3a-product-schema-v3.5"
     ],
     "title": "Schema Version",
     "type": "string"
    },
    "vocabulary_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Vocabulary Version",
     "type": "string"
    }
   },
   "required": [
    "schema_version",
    "questionnaire_version",
    "vocabulary_version",
    "health_questionnaire_version",
    "conversion_version",
    "data_pack"
   ],
   "title": "ProductMeta",
   "type": "object"
  },
  "SampleLabel": {
   "additionalProperties": false,
   "description": "公共样例的出处标签（只出现在样例里；真实运行的消息不写）。\n\n* ``offline_run``：由离线闭环实际执行产生；\n* ``controlled_fixture``：受控测试夹具（例如写好的计划、注入的事件、构造的资料缺口），标明来源；\n* ``contract_example``：线上服务（幂等提交、查询、断线恢复）尚未实现，这里只是**标明为示例**的契约响应。",
   "properties": {
    "note": {
     "maxLength": 600,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "origin": {
     "enum": [
      "offline_run",
      "controlled_fixture",
      "contract_example"
     ],
     "title": "Origin",
     "type": "string"
    },
    "produced_by": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Produced By",
     "type": "string"
    },
    "synthetic": {
     "const": true,
     "default": true,
     "title": "Synthetic",
     "type": "boolean"
    }
   },
   "required": [
    "origin",
    "produced_by",
    "note"
   ],
   "title": "SampleLabel",
   "type": "object"
  },
  "TasteAnswer": {
   "additionalProperties": false,
   "description": "口味与菜系：未答、暂不确定、明确没有偏好、从面板选中菜系，或用文字描述（兼容：先解释、再由用户选中确认）。",
   "properties": {
    "selected": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Selected",
     "type": "array"
    },
    "state": {
     "default": "unanswered",
     "enum": [
      "unanswered",
      "unsure",
      "no_preference",
      "described",
      "selected"
     ],
     "title": "State",
     "type": "string"
    },
    "text": {
     "anyOf": [
      {
       "maxLength": 300,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Text"
    }
   },
   "title": "TasteAnswer",
   "type": "object"
  },
  "UserInputDraft": {
   "additionalProperties": false,
   "description": "一份原始答案草稿（逐项保存状态）。原始答案、候选解释与确认画像分层保存：这里只有原始答案。",
   "properties": {
    "abilities": {
     "default": [],
     "items": {
      "$ref": "#/$defs/AbilityClaim"
     },
     "title": "Abilities",
     "type": "array"
    },
    "age": {
     "$ref": "#/$defs/AgeAnswer"
    },
    "attribute_preferences": {
     "default": [],
     "items": {
      "$ref": "#/$defs/AttributePreferenceAnswer"
     },
     "title": "Attribute Preferences",
     "type": "array"
    },
    "cash": {
     "$ref": "#/$defs/CashAnswer"
    },
    "certificates": {
     "$ref": "#/$defs/CertificatesAnswer"
    },
    "cities": {
     "$ref": "#/$defs/CitiesAnswer"
    },
