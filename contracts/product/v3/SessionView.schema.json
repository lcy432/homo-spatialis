{
 "$defs": {
  "DataPackRef": {
   "additionalProperties": false,
   "description": "一份资料包的身份：编号、内容指纹与状态（合成测试资料，或冻结的真实资料包）。",
   "properties": {
    "content_fingerprint": {
     "pattern": "^[0-9a-f]{64}$",
     "title": "Content Fingerprint",
     "type": "string"
    },
    "note": {
     "maxLength": 400,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "pack_id": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$",
     "title": "Pack Id",
     "type": "string"
    },
    "status": {
     "enum": [
      "synthetic_fixture_only",
      "real_data_frozen"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "pack_id",
    "content_fingerprint",
    "status",
    "note"
   ],
   "title": "DataPackRef",
   "type": "object"
  },
  "DraftSummary": {
   "additionalProperties": false,
   "properties": {
    "draft_id": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$",
     "title": "Draft Id",
     "type": "string"
    },
    "expires_at": {
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
     "title": "Expires At",
     "type": "string"
    },
    "revision": {
     "minimum": 1,
     "title": "Revision",
     "type": "integer"
    },
    "updated_at": {
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
     "title": "Updated At",
     "type": "string"
    }
   },
   "required": [
    "draft_id",
    "revision",
    "updated_at",
    "expires_at"
   ],
   "title": "DraftSummary",
   "type": "object"
  },
  "ProductMeta": {
   "additionalProperties": false,
   "description": "每条产品消息都带的共同元数据：结构、问卷、词表、健康问卷、转换的版本与资料包身份。",
   "properties": {
    "conversion_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Conversion Version",
     "type": "string"
    },
    "data_pack": {
     "$ref": "#/$defs/DataPackRef"
    },
    "health_questionnaire_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Health Questionnaire Version",
     "type": "string"
    },
    "questionnaire_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Questionnaire Version",
     "type": "string"
    },
    "sample": {
     "anyOf": [
      {
       "$ref": "#/$defs/SampleLabel"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "schema_version": {
     "const": "e3a-product-schema-v3.2",
     "title": "Schema Version",
     "type": "string"
    },
    "vocabulary_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Vocabulary Version",
     "type": "string"
    }
   },
   "required": [
    "schema_version",
    "questionnaire_version",
    "vocabulary_version",
    "health_questionnaire_version",
    "conversion_version",
    "data_pack"
   ],
   "title": "ProductMeta",
   "type": "object"
  },
  "QuotaSummary": {
   "additionalProperties": false,
   "description": "这个专属空间的使用次数：一共 ``total`` 次启动模拟的机会；``used`` 已开始的、``reserved`` 已确认开始但还没有启动的、\n``available`` 还能用的。次数不自动重置；删除结果、换设备、重发链接都不改变它。3 次是启动模拟的机会，不保证每次所有分身都完整。",
   "properties": {
    "available": {
     "minimum": 0,
     "title": "Available",
     "type": "integer"
    },
    "reserved": {
     "minimum": 0,
     "title": "Reserved",
     "type": "integer"
    },
    "total": {
     "minimum": 0,
     "title": "Total",
     "type": "integer"
    },
    "used": {
     "minimum": 0,
     "title": "Used",
     "type": "integer"
    }
   },
   "required": [
    "total",
    "used",
    "reserved",
    "available"
   ],
   "title": "QuotaSummary",
   "type": "object"
  },
  "SampleLabel": {
   "additionalProperties": false,
   "description": "公共样例的出处标签（只出现在样例里；真实运行的消息不写）。\n\n* ``offline_run``：由离线闭环实际执行产生；\n* ``controlled_fixture``：受控测试夹具（例如写好的计划、注入的事件、构造的资料缺口），标明来源；\n* ``contract_example``：线上服务（幂等提交、查询、断线恢复）尚未实现，这里只是**标明为示例**的契约响应。",
   "properties": {
    "note": {
     "maxLength": 600,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "origin": {
     "enum": [
      "offline_run",
      "controlled_fixture",
      "contract_example"
     ],
     "title": "Origin",
     "type": "string"
    },
    "produced_by": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Produced By",
     "type": "string"
    },
    "synthetic": {
     "const": true,
     "default": true,
     "title": "Synthetic",
     "type": "boolean"
    }
   },
   "required": [
    "origin",
    "produced_by",
    "note"
   ],
   "title": "SampleLabel",
   "type": "object"
  },
  "ServiceRules": {
   "additionalProperties": false,
   "description": "服务的固定规则（服务端配置产生，网页只显示，不能修改）。",
   "properties": {
    "cities": {
     "minimum": 1,
     "title": "Cities",
     "type": "integer"
    },
    "clones_per_city": {
     "minimum": 1,
     "title": "Clones Per City",
     "type": "integer"
    },
    "currency": {
     "enum": [
      "CNY",
      "USD"
     ],
     "title": "Currency",
     "type": "string"
    },
    "draft_retention_days": {
     "minimum": 1,
     "title": "Draft Retention Days",
     "type": "integer"
    },
    "intent_retention_days": {
     "minimum": 1,
     "title": "Intent Retention Days",
     "type": "integer"
    },
    "live_calls_enabled": {
     "title": "Live Calls Enabled",
     "type": "boolean"
    },
    "max_cost": {
     "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
     "title": "Max Cost",
     "type": "string"
    },
    "notes_zh": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Notes Zh",
     "type": "array"
    },
    "planner_kind": {
     "enum": [
      "mock",
      "llm"
     ],
     "title": "Planner Kind",
     "type": "string"
    },
    "result_retention_days": {
     "minimum": 1,
     "title": "Result Retention Days",
     "type": "integer"
    },
    "runs_total": {
     "minimum": 1,
     "title": "Runs Total",
     "type": "integer"
    },
    "session_days": {
     "minimum": 1,
     "title": "Session Days",
     "type": "integer"
    },
    "years": {
     "minimum": 1,
     "title": "Years",
     "type": "integer"
    }
   },
   "required": [
    "runs_total",
    "cities",
    "clones_per_city",
    "years",
    "planner_kind",
    "live_calls_enabled",
    "max_cost",
    "currency",
    "result_retention_days",
    "draft_retention_days",
    "intent_retention_days",
    "session_days"
   ],
   "title": "ServiceRules",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "description": "当前会话（``POST /api/v1/session`` 交换邀请之后、``GET /api/v1/session``）：到期时间、本会话的 CSRF token、次数与服务规则。\n会话由 HttpOnly Cookie 携带，这里不返回会话秘密；``csrf_token`` 只在修改请求的 ``X-CSRF-Token`` 头里带回。",
 "properties": {
  "csrf_token": {
   "maxLength": 128,
   "minLength": 32,
   "pattern": "^[A-Za-z0-9_\\-]+$",
   "title": "Csrf Token",
   "type": "string"
  },
  "drafts": {
   "default": [],
   "items": {
    "$ref": "#/$defs/DraftSummary"
   },
   "title": "Drafts",
   "type": "array"
  },
  "meta": {
   "$ref": "#/$defs/ProductMeta"
  },
  "open_intent_id": {
   "anyOf": [
    {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$",
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Open Intent Id"
  },
  "quota": {
   "$ref": "#/$defs/QuotaSummary"
  },
  "rules": {
   "$ref": "#/$defs/ServiceRules"
  },
  "session_expires_at": {
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
   "title": "Session Expires At",
   "type": "string"
  }
 },
 "required": [
  "meta",
  "session_expires_at",
  "csrf_token",
  "quota",
  "rules"
 ],
 "title": "SessionView",
 "type": "object"
}
