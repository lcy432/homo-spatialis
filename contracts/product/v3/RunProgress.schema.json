{
 "$defs": {
  "CloneProgress": {
   "additionalProperties": false,
   "properties": {
    "city_ref": {
     "title": "City Ref",
     "type": "string"
    },
    "clone_ref": {
     "title": "Clone Ref",
     "type": "string"
    },
    "status": {
     "title": "Status",
     "type": "string"
    },
    "status_zh": {
     "title": "Status Zh",
     "type": "string"
    },
    "years_committed": {
     "minimum": 0,
     "title": "Years Committed",
     "type": "integer"
    }
   },
   "required": [
    "clone_ref",
    "city_ref",
    "status",
    "status_zh",
    "years_committed"
   ],
   "title": "CloneProgress",
   "type": "object"
  },
  "CostStatus": {
   "additionalProperties": false,
   "description": "费用状态：离线 mock 为零；真实模型只能写“按报价估算”，以供应商账单为准。\n\n``calls_used`` / ``call_limit`` 数的是**规划候选**（每个分身每年一次正常规划、最多两次修订）；``service_attempts`` 数的是实际发给\n服务的尝试（每份候选最多再试一次服务请求），两者不是同一个计数。金额都是应用侧按已记录报价估算（E3C）：``settled_cost`` 是返回了\n用量、已核算的；``uncertain_cost`` 是请求可能已经发出、用量不确定、按预留保留的（不改成 0）；``in_flight_cost`` 是已经预留、还没有\n结果的；``estimated_cost`` 是三者之和。``max_cost`` 是这次运行的应用侧上限，不是供应商的账单上限。",
   "properties": {
    "call_limit": {
     "minimum": 0,
     "title": "Call Limit",
     "type": "integer"
    },
    "calls_used": {
     "minimum": 0,
     "title": "Calls Used",
     "type": "integer"
    },
    "currency": {
     "anyOf": [
      {
       "enum": [
        "CNY",
        "USD"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Currency"
    },
    "estimated_cost": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Estimated Cost"
    },
    "in_flight_cost": {
     "anyOf": [
      {
       "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "In Flight Cost"
    },
    "kind": {
     "enum": [
      "offline_mock_zero_cost",
      "estimated_from_quote"
     ],
     "title": "Kind",
     "type": "string"
    },
    "max_cost": {
     "anyOf": [
      {
       "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Max Cost"
    },
    "note": {
     "title": "Note",
     "type": "string"
    },
    "price_version": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Price Version"
    },
    "service_attempt_limit": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Service Attempt Limit"
    },
    "service_attempts": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Service Attempts"
    },
    "settled_cost": {
     "anyOf": [
      {
       "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Settled Cost"
    },
    "uncertain_attempts": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Uncertain Attempts"
    },
    "uncertain_cost": {
     "anyOf": [
      {
       "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Uncertain Cost"
    }
   },
   "required": [
    "kind",
    "calls_used",
    "call_limit",
    "note"
   ],
   "title": "CostStatus",
   "type": "object"
  },
  "DataPackRef": {
   "additionalProperties": false,
   "description": "一份资料包的身份：编号、内容指纹与状态（合成测试资料，或冻结的真实资料包）。",
   "properties": {
    "content_fingerprint": {
     "pattern": "^[0-9a-f]{64}$",
     "title": "Content Fingerprint",
     "type": "string"
    },
    "note": {
     "maxLength": 400,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "pack_id": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$",
     "title": "Pack Id",
     "type": "string"
    },
    "status": {
     "enum": [
      "synthetic_fixture_only",
      "real_data_frozen"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "pack_id",
    "content_fingerprint",
    "status",
    "note"
   ],
   "title": "DataPackRef",
   "type": "object"
  },
  "ProductMeta": {
   "additionalProperties": false,
   "description": "每条产品消息都带的共同元数据：结构、问卷、词表、健康问卷、转换的版本与资料包身份。",
   "properties": {
    "conversion_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Conversion Version",
     "type": "string"
    },
    "data_pack": {
     "$ref": "#/$defs/DataPackRef"
    },
    "health_questionnaire_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Health Questionnaire Version",
     "type": "string"
    },
    "questionnaire_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Questionnaire Version",
     "type": "string"
    },
    "sample": {
     "anyOf": [
      {
       "$ref": "#/$defs/SampleLabel"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "schema_version": {
     "enum": [
      "e3a-product-schema-v3.3",
      "e3a-product-schema-v3.4",
      "e3a-product-schema-v3.5"
     ],
     "title": "Schema Version",
     "type": "string"
    },
    "vocabulary_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Vocabulary Version",
     "type": "string"
    }
   },
   "required": [
    "schema_version",
    "questionnaire_version",
    "vocabulary_version",
    "health_questionnaire_version",
    "conversion_version",
    "data_pack"
   ],
   "title": "ProductMeta",
   "type": "object"
  },
  "PublicExplanation": {
   "additionalProperties": false,
   "description": "给用户看的状态说明（E3-A 收尾 F5）：只由结构化类别生成——类别代码、中文原因、影响与下一步，加一个不含内部内容的审计编号。\n\n不透传异常原文、内部路径或参数；完整原文留在运行归档或内部诊断里，``audit_ref`` 指向它（运行编号、分身与记录文件）。",
   "properties": {
    "audit_ref": {
     "anyOf": [
      {
       "maxLength": 200,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Audit Ref"
    },
    "category": {
     "pattern": "^[a-z][a-z0-9_]{1,63}$",
     "title": "Category",
     "type": "string"
    },
    "impact_zh": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Impact Zh",
     "type": "string"
    },
    "next_action_zh": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Next Action Zh",
     "type": "string"
    },
    "reason_zh": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Reason Zh",
     "type": "string"
    }
   },
   "required": [
    "category",
    "reason_zh",
    "impact_zh",
    "next_action_zh"
   ],
   "title": "PublicExplanation",
   "type": "object"
  },
  "SampleLabel": {
   "additionalProperties": false,
   "description": "公共样例的出处标签（只出现在样例里；真实运行的消息不写）。\n\n* ``offline_run``：由离线闭环实际执行产生；\n* ``controlled_fixture``：受控测试夹具（例如写好的计划、注入的事件、构造的资料缺口），标明来源；\n* ``contract_example``：线上服务（幂等提交、查询、断线恢复）尚未实现，这里只是**标明为示例**的契约响应。",
   "properties": {
    "note": {
     "maxLength": 600,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "origin": {
     "enum": [
      "offline_run",
      "controlled_fixture",
      "contract_example"
     ],
     "title": "Origin",
     "type": "string"
    },
    "produced_by": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Produced By",
     "type": "string"
    },
    "synthetic": {
     "const": true,
     "default": true,
     "title": "Synthetic",
     "type": "boolean"
    }
   },
   "required": [
    "origin",
    "produced_by",
    "note"
   ],
   "title": "SampleLabel",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "description": "一次运行的进度（断线后用运行 ID 查询；不重发付费规划）。请求成功、计划可执行、生活完成、评分完整分别记录。",
 "properties": {
  "clone_years_planned": {
   "anyOf": [
    {
     "minimum": 1,
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Clone Years Planned"
  },
  "clone_years_settled": {
   "anyOf": [
    {
     "minimum": 0,
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Clone Years Settled"
  },
  "clones": {
   "default": [],
   "items": {
    "$ref": "#/$defs/CloneProgress"
   },
   "title": "Clones",
   "type": "array"
  },
  "cost": {
   "$ref": "#/$defs/CostStatus"
  },
  "meta": {
   "$ref": "#/$defs/ProductMeta"
  },
  "pause": {
   "anyOf": [
    {
     "$ref": "#/$defs/PublicExplanation"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "report_available": {
   "title": "Report Available",
   "type": "boolean"
  },
  "resumable": {
   "title": "Resumable",
   "type": "boolean"
  },
  "resume_note": {
   "title": "Resume Note",
   "type": "string"
  },
  "run_id": {
   "title": "Run Id",
   "type": "string"
  },
  "stage": {
   "enum": [
    "queued",
    "running",
    "completed",
    "paused",
    "halted",
    "interrupted",
    "budget_exhausted"
   ],
   "title": "Stage",
   "type": "string"
  },
  "stage_zh": {
   "title": "Stage Zh",
   "type": "string"
  },
  "updated_at": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Updated At"
  }
 },
 "required": [
  "meta",
  "run_id",
  "stage",
  "stage_zh",
  "cost",
  "resumable",
  "resume_note",
  "report_available"
 ],
 "title": "RunProgress",
 "type": "object"
}
