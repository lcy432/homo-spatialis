{
 "$defs": {
  "AbilityOption": {
   "additionalProperties": false,
   "description": "一项可以由用户确认的资格事实（不从职称自动授予）。",
   "properties": {
    "ability_id": {
     "pattern": "^[a-z][a-z0-9_]{1,47}$",
     "title": "Ability Id",
     "type": "string"
    },
    "ask_when": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Ask When",
     "type": "string"
    },
    "label": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Label",
     "type": "string"
    }
   },
   "required": [
    "ability_id",
    "label",
    "ask_when"
   ],
   "title": "AbilityOption",
   "type": "object"
  },
  "AttributeKindDef": {
   "additionalProperties": false,
   "description": "属性偏好的种类（品牌、菜系、制作方式、档次、服务质量、上门顾虑……）：本版的支持状态与用途。",
   "properties": {
    "kind": {
     "pattern": "^[a-z][a-z0-9_]{1,47}$",
     "title": "Kind",
     "type": "string"
    },
    "label": {
     "maxLength": 40,
     "minLength": 1,
     "title": "Label",
     "type": "string"
    },
    "note": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "support": {
     "enum": [
      "supported",
      "partially_supported",
      "unsupported"
     ],
     "title": "Support",
     "type": "string"
    },
    "usage": {
     "items": {
      "enum": [
       "planning",
       "start_state",
       "qualification",
       "scoring",
       "retained_only"
      ],
      "type": "string"
     },
     "minItems": 1,
     "title": "Usage",
     "type": "array"
    }
   },
   "required": [
    "kind",
    "label",
    "support",
    "usage",
    "note"
   ],
   "title": "AttributeKindDef",
   "type": "object"
  },
  "CatalogGroup": {
   "additionalProperties": false,
   "description": "职业目录的一个浏览分组。分组只用于浏览，不改变职业映射，也不进确认画像。",
   "properties": {
    "group_id": {
     "pattern": "^[a-z][a-z0-9_]{0,47}$",
     "title": "Group Id",
     "type": "string"
    },
    "label": {
     "maxLength": 40,
     "minLength": 1,
     "title": "Label",
     "type": "string"
    },
    "order": {
     "minimum": 1,
     "title": "Order",
     "type": "integer"
    }
   },
   "required": [
    "group_id",
    "label",
    "order"
   ],
   "title": "CatalogGroup",
   "type": "object"
  },
  "CatalogOccupation": {
   "additionalProperties": false,
   "description": "目录里的一个职业：概念编号（与文字匹配、确认画像用的是同一个概念）、唯一的主分组、名称、职责、搜索词与相关资格。\n\n``search_terms`` 是明确登记的中英文搜索词（名称、资料包别名与目录补充的叫法，例如“程序员”），照原文给出、不翻译，只用来筛选；\n搜索框里的文字不保存、不进画像。``qualification_refs`` 是这个职业的开局岗位要求的资格（能力清单 ``abilities`` 里的编号），只供\n显示；学历包含关系、证书授予与经验年数的判断都在 E3。分类代码只在内部保留，不在这里。",
   "properties": {
    "concept_id": {
     "pattern": "^[a-z][a-z0-9_.]{1,79}$",
     "title": "Concept Id",
     "type": "string"
    },
    "duties": {
     "items": {
      "type": "string"
     },
     "minItems": 1,
     "title": "Duties",
     "type": "array"
    },
    "experience_question": {
     "anyOf": [
      {
       "maxLength": 80,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Experience Question"
    },
    "group_id": {
     "pattern": "^[a-z][a-z0-9_]{0,47}$",
     "title": "Group Id",
     "type": "string"
    },
    "label": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Label",
     "type": "string"
    },
    "order": {
     "minimum": 1,
     "title": "Order",
     "type": "integer"
    },
    "qualification_refs": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Qualification Refs",
     "type": "array"
    },
    "search_terms": {
     "items": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "minItems": 1,
     "title": "Search Terms",
     "type": "array"
    }
   },
   "required": [
    "concept_id",
    "group_id",
    "order",
    "label",
    "duties",
    "search_terms"
   ],
   "title": "CatalogOccupation",
   "type": "object"
  },
  "CatalogSearchRules": {
   "additionalProperties": false,
   "description": "目录搜索的规则（E5 在完整的小目录里筛选显示；服务端只认提交的编号，不认搜索词）。",
   "properties": {
    "method": {
     "const": "catalog_search_nfkc_casefold_all_terms_v1",
     "title": "Method",
     "type": "string"
    },
    "no_match": {
     "maxLength": 300,
     "minLength": 1,
     "title": "No Match",
     "type": "string"
    },
    "rules": {
     "items": {
      "type": "string"
     },
     "minItems": 1,
     "title": "Rules",
     "type": "array"
    }
   },
   "required": [
    "method",
    "rules",
    "no_match"
   ],
   "title": "CatalogSearchRules",
   "type": "object"
  },
  "CertificateOption": {
   "additionalProperties": false,
   "description": "一张可以多选的职业证书（中学后非学位证书）：资格编号、名称，以及要求它的职业。学历不会授予它。",
   "properties": {
    "ability_id": {
     "pattern": "^[a-z][a-z0-9_]{1,47}$",
     "title": "Ability Id",
     "type": "string"
    },
    "label": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Label",
     "type": "string"
    },
    "occupations": {
     "items": {
      "pattern": "^[a-z][a-z0-9_.]{1,79}$",
      "type": "string"
     },
     "minItems": 1,
     "title": "Occupations",
     "type": "array"
    }
   },
   "required": [
    "ability_id",
    "label",
    "occupations"
   ],
   "title": "CertificateOption",
   "type": "object"
  },
  "CityOption": {
   "additionalProperties": false,
   "description": "一个候选城市：完整身份（国家 / 地理体系 / 代码）与地理边界版本；不用中文名拼接资料。",
   "properties": {
    "city_ref": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$",
     "title": "City Ref",
     "type": "string"
    },
    "code": {
     "maxLength": 40,
     "minLength": 1,
     "title": "Code",
     "type": "string"
    },
    "country": {
     "pattern": "^[A-Z]{2}$",
     "title": "Country",
     "type": "string"
    },
    "data_status": {
     "enum": [
      "synthetic_fixture",
      "real_data"
     ],
     "title": "Data Status",
     "type": "string"
    },
    "geography_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Geography Version",
     "type": "string"
    },
    "label": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Label",
     "type": "string"
    },
    "note": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "scheme": {
     "maxLength": 40,
     "minLength": 1,
     "title": "Scheme",
     "type": "string"
    },
    "selectable": {
     "title": "Selectable",
     "type": "boolean"
    }
   },
   "required": [
    "city_ref",
    "country",
    "scheme",
    "code",
    "label",
    "geography_version",
    "data_status",
    "selectable",
    "note"
   ],
   "title": "CityOption",
   "type": "object"
  },
  "DataPackRef": {
   "additionalProperties": false,
   "description": "一份资料包的身份：编号、内容指纹与状态（合成测试资料，或冻结的真实资料包）。",
   "properties": {
    "content_fingerprint": {
     "pattern": "^[0-9a-f]{64}$",
     "title": "Content Fingerprint",
     "type": "string"
    },
    "note": {
     "maxLength": 400,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "pack_id": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$",
     "title": "Pack Id",
     "type": "string"
    },
    "status": {
     "enum": [
      "synthetic_fixture_only",
      "real_data_frozen"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "pack_id",
    "content_fingerprint",
    "status",
    "note"
   ],
   "title": "DataPackRef",
   "type": "object"
  },
  "DimensionDefinition": {
   "additionalProperties": false,
   "description": "六维之一的统一定义：中性题干、具体的参考改善范围与当前覆盖。全比较组共用，不逐城重新标定用户权重。",
   "properties": {
    "definition": {
     "maxLength": 400,
     "minLength": 1,
     "title": "Definition",
     "type": "string"
    },
    "key": {
     "enum": [
      "material",
      "safety",
      "opportunity",
      "leisure",
      "environment",
      "commute"
     ],
     "title": "Key",
     "type": "string"
    },
    "label": {
     "maxLength": 40,
     "minLength": 1,
     "title": "Label",
     "type": "string"
    },
    "reference_improvement": {
     "maxLength": 400,
     "minLength": 1,
     "title": "Reference Improvement",
     "type": "string"
    },
    "support": {
     "enum": [
      "supported",
      "partially_supported",
      "unsupported"
     ],
     "title": "Support",
     "type": "string"
    },
    "support_note": {
     "maxLength": 400,
     "minLength": 1,
     "title": "Support Note",
     "type": "string"
    }
   },
   "required": [
    "key",
    "label",
    "definition",
    "reference_improvement",
    "support",
    "support_note"
   ],
   "title": "DimensionDefinition",
   "type": "object"
  },
  "EducationOption": {
   "additionalProperties": false,
   "description": "最高学历的一个选项（单选，按从低到高的顺序）。职业证书不在这里，另有证书多选。",
   "properties": {
    "label": {
     "maxLength": 40,
     "minLength": 1,
     "title": "Label",
     "type": "string"
    },
    "option_id": {
     "pattern": "^[a-z][a-z0-9_]{0,47}$",
     "title": "Option Id",
     "type": "string"
    },
    "order": {
     "minimum": 1,
     "title": "Order",
     "type": "integer"
    }
   },
   "required": [
    "option_id",
    "label",
    "order"
   ],
   "title": "EducationOption",
   "type": "object"
  },
  "ExperienceQuestion": {
   "additionalProperties": false,
   "description": "一个相关工作经验问题：只在选中的职业属于 ``applies_to`` 时问；用户在 ``related`` 列出的职业里填做过几年。年数门槛只写在\n``prompt`` 的说明里，由 E3 判断（E5 不判断）。",
   "properties": {
    "ability_id": {
     "pattern": "^[a-z][a-z0-9_]{1,47}$",
     "title": "Ability Id",
     "type": "string"
    },
    "applies_to": {
     "items": {
      "pattern": "^[a-z][a-z0-9_.]{1,79}$",
      "type": "string"
     },
     "minItems": 1,
     "title": "Applies To",
     "type": "array"
    },
    "prompt": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Prompt",
     "type": "string"
    },
    "question_id": {
     "pattern": "^[a-z][a-z0-9_.]{1,79}$",
     "title": "Question Id",
     "type": "string"
    },
    "related": {
     "items": {
      "pattern": "^[a-z][a-z0-9_.]{1,79}$",
      "type": "string"
     },
     "minItems": 1,
     "title": "Related",
     "type": "array"
    }
   },
   "required": [
    "question_id",
    "ability_id",
    "applies_to",
    "related",
    "prompt"
   ],
   "title": "ExperienceQuestion",
   "type": "object"
  },
  "HardRequirementOption": {
   "additionalProperties": false,
   "description": "一个受支持的硬要求选项：有定义、有资料、能按月核验。**核验只单独报告，环境不拦截计划**（``enforced_by_execution``）。",
   "properties": {
    "compiles_to": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Compiles To",
     "type": "string"
    },
    "enforced_by_execution": {
     "const": false,
     "default": false,
     "title": "Enforced By Execution",
     "type": "boolean"
    },
    "label": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Label",
     "type": "string"
    },
    "maximum": {
     "title": "Maximum",
     "type": "integer"
    },
    "minimum": {
     "title": "Minimum",
     "type": "integer"
    },
    "option_id": {
     "pattern": "^[a-z][a-z0-9_.]{1,63}$",
     "title": "Option Id",
     "type": "string"
    },
    "parameter": {
     "maxLength": 48,
     "minLength": 1,
     "title": "Parameter",
     "type": "string"
    },
    "step": {
     "minimum": 1,
     "title": "Step",
     "type": "integer"
    },
    "unit": {
     "maxLength": 40,
     "minLength": 1,
     "title": "Unit",
     "type": "string"
    },
    "verification": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Verification",
     "type": "string"
    }
   },
   "required": [
    "option_id",
    "label",
    "parameter",
    "unit",
    "minimum",
    "maximum",
    "step",
    "compiles_to",
    "verification"
   ],
   "title": "HardRequirementOption",
   "type": "object"
  },
  "HealthOptionDef": {
   "additionalProperties": false,
   "properties": {
    "label": {
     "maxLength": 20,
     "minLength": 1,
     "title": "Label",
     "type": "string"
    },
    "meaning": {
     "maxLength": 200,
     "minLength": 1,
     "title": "Meaning",
     "type": "string"
    },
    "option_id": {
     "enum": [
      "agree",
      "disagree",
      "no_clear_tendency",
      "unsure"
     ],
     "title": "Option Id",
     "type": "string"
    }
   },
   "required": [
    "option_id",
    "label",
    "meaning"
   ],
   "title": "HealthOptionDef",
   "type": "object"
  },
  "HealthQuestion": {
   "additionalProperties": false,
   "properties": {
    "question_id": {
     "pattern": "^[a-z][a-z0-9_]{1,47}$",
     "title": "Question Id",
     "type": "string"
    },
    "text": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Text",
     "type": "string"
    }
   },
   "required": [
    "question_id",
    "text"
   ],
   "title": "HealthQuestion",
   "type": "object"
  },
  "HealthQuestionnaire": {
   "additionalProperties": false,
   "description": "独立健康问卷（不占六维 100 分，不是第七个评分权重）。题目是暂定文案，**未经量表验证**。",
   "properties": {
    "common_prompt": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Common Prompt",
     "type": "string"
    },
    "options": {
     "items": {
      "$ref": "#/$defs/HealthOptionDef"
     },
     "maxItems": 4,
     "minItems": 4,
     "title": "Options",
     "type": "array"
    },
    "questions": {
     "items": {
      "$ref": "#/$defs/HealthQuestion"
     },
     "minItems": 1,
     "title": "Questions",
     "type": "array"
    },
    "rules": {
     "items": {
      "type": "string"
     },
     "title": "Rules",
     "type": "array"
    },
    "status": {
     "const": "draft_wording_not_validated",
     "title": "Status",
     "type": "string"
    },
    "unanswered_rule": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Unanswered Rule",
     "type": "string"
    },
    "version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Version",
     "type": "string"
    }
   },
   "required": [
    "version",
    "status",
    "common_prompt",
    "questions",
    "options",
    "unanswered_rule",
    "rules"
   ],
   "title": "HealthQuestionnaire",
   "type": "object"
  },
  "InputCatalog": {
   "additionalProperties": false,
   "description": "输入目录（v3.4）：职业的分类索引与搜索词、学历 / 证书 / 相关经验问题、兴趣与菜系的分组，以及新流程启用的板块。\n\n它是一份独立的小配置，引用资料包里已有的职业、资格与兴趣键，不新增职业、资格、活动或评分系数。``content_fingerprint`` 是这份\n配置与所引用资料包的内容身份：按目录选职业的草稿要带上它，目录换了就要重新选（服务端拒绝过期的目录）。",
   "properties": {
    "catalog_id": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$",
     "title": "Catalog Id",
     "type": "string"
    },
    "catalog_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Catalog Version",
     "type": "string"
    },
    "certificates": {
     "default": [],
     "items": {
      "$ref": "#/$defs/CertificateOption"
     },
     "title": "Certificates",
     "type": "array"
    },
    "content_fingerprint": {
     "pattern": "^[0-9a-f]{64}$",
     "title": "Content Fingerprint",
     "type": "string"
    },
    "education": {
     "default": [],
     "items": {
      "$ref": "#/$defs/EducationOption"
     },
     "title": "Education",
     "type": "array"
    },
    "experience": {
     "default": [],
     "items": {
      "$ref": "#/$defs/ExperienceQuestion"
     },
     "title": "Experience",
     "type": "array"
    },
    "groups": {
     "items": {
      "$ref": "#/$defs/CatalogGroup"
     },
     "minItems": 1,
     "title": "Groups",
     "type": "array"
    },
    "leisure": {
     "$ref": "#/$defs/InterestPanel"
    },
    "notes": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Notes",
     "type": "array"
    },
    "occupations": {
     "items": {
      "$ref": "#/$defs/CatalogOccupation"
     },
     "minItems": 1,
     "title": "Occupations",
     "type": "array"
    },
    "pack_id": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Pack Id",
     "type": "string"
    },
    "qualification_states": {
     "default": [],
     "items": {
      "$ref": "#/$defs/QualificationStateText"
     },
     "title": "Qualification States",
     "type": "array"
    },
    "search": {
     "$ref": "#/$defs/CatalogSearchRules"
    },
    "sections": {
     "$ref": "#/$defs/InputSections"
    },
    "taste": {
     "$ref": "#/$defs/InterestPanel"
    }
   },
   "required": [
    "catalog_id",
    "catalog_version",
    "content_fingerprint",
    "pack_id",
    "sections",
    "search",
    "groups",
    "occupations",
    "leisure",
    "taste"
   ],
   "title": "InputCatalog",
   "type": "object"
  },
  "InputSections": {
   "additionalProperties": false,
   "description": "新输入流程启用哪些板块。职业按目录直接选（文字描述只为兼容保留，不是必经入口）；兴趣与口味用面板多选；硬要求、属性偏好\n与兴趣的文字解释不在新流程里。",
   "properties": {
    "attribute_preferences": {
     "const": false,
     "default": false,
     "title": "Attribute Preferences",
     "type": "boolean"
    },
    "certificates": {
     "title": "Certificates",
     "type": "boolean"
    },
    "education": {
     "title": "Education",
     "type": "boolean"
    },
    "experience": {
     "title": "Experience",
     "type": "boolean"
    },
    "hard_requirements": {
     "const": false,
     "default": false,
     "title": "Hard Requirements",
     "type": "boolean"
    },
    "interest_text": {
     "const": false,
     "default": false,
     "title": "Interest Text",
     "type": "boolean"
    },
    "leisure": {
     "const": "panel_select",
