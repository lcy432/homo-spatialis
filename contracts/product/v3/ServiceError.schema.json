{
 "$defs": {
  "DataPackRef": {
   "additionalProperties": false,
   "description": "一份资料包的身份：编号、内容指纹与状态（合成测试资料，或冻结的真实资料包）。",
   "properties": {
    "content_fingerprint": {
     "pattern": "^[0-9a-f]{64}$",
     "title": "Content Fingerprint",
     "type": "string"
    },
    "note": {
     "maxLength": 400,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "pack_id": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$",
     "title": "Pack Id",
     "type": "string"
    },
    "status": {
     "enum": [
      "synthetic_fixture_only",
      "real_data_frozen"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "pack_id",
    "content_fingerprint",
    "status",
    "note"
   ],
   "title": "DataPackRef",
   "type": "object"
  },
  "ProductMeta": {
   "additionalProperties": false,
   "description": "每条产品消息都带的共同元数据：结构、问卷、词表、健康问卷、转换的版本与资料包身份。",
   "properties": {
    "conversion_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Conversion Version",
     "type": "string"
    },
    "data_pack": {
     "$ref": "#/$defs/DataPackRef"
    },
    "health_questionnaire_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Health Questionnaire Version",
     "type": "string"
    },
    "questionnaire_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Questionnaire Version",
     "type": "string"
    },
    "sample": {
     "anyOf": [
      {
       "$ref": "#/$defs/SampleLabel"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "schema_version": {
     "const": "e3a-product-schema-v3.3",
     "title": "Schema Version",
     "type": "string"
    },
    "vocabulary_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Vocabulary Version",
     "type": "string"
    }
   },
   "required": [
    "schema_version",
    "questionnaire_version",
    "vocabulary_version",
    "health_questionnaire_version",
    "conversion_version",
    "data_pack"
   ],
   "title": "ProductMeta",
   "type": "object"
  },
  "SampleLabel": {
   "additionalProperties": false,
   "description": "公共样例的出处标签（只出现在样例里；真实运行的消息不写）。\n\n* ``offline_run``：由离线闭环实际执行产生；\n* ``controlled_fixture``：受控测试夹具（例如写好的计划、注入的事件、构造的资料缺口），标明来源；\n* ``contract_example``：线上服务（幂等提交、查询、断线恢复）尚未实现，这里只是**标明为示例**的契约响应。",
   "properties": {
    "note": {
     "maxLength": 600,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "origin": {
     "enum": [
      "offline_run",
      "controlled_fixture",
      "contract_example"
     ],
     "title": "Origin",
     "type": "string"
    },
    "produced_by": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Produced By",
     "type": "string"
    },
    "synthetic": {
     "const": true,
     "default": true,
     "title": "Synthetic",
     "type": "boolean"
    }
   },
   "required": [
    "origin",
    "produced_by",
    "note"
   ],
   "title": "SampleLabel",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "description": "统一的安全错误：机器代码、HTTP 状态与“发生了什么—影响是什么—下一步怎么做”的中文，加一个支持编号。不含用户输入、内部路径、\n堆栈、原始校验异常或秘密。",
 "properties": {
  "code": {
   "enum": [
    "unauthenticated",
    "not_found",
    "revision_conflict",
    "preflight_stale",
    "quota_exhausted",
    "idempotency_conflict",
    "intent_conflict",
    "not_resumable",
    "result_unavailable",
    "deleting",
    "deleted",
    "expired",
    "data_pack_unavailable",
    "paid_calls_disabled",
    "run_scale_fixed",
    "rate_limited",
    "csrf_failed",
    "origin_rejected",
    "payload_too_large",
    "invalid_request",
    "internal_error"
   ],
   "title": "Code",
   "type": "string"
  },
  "impact_zh": {
   "maxLength": 300,
   "minLength": 1,
   "title": "Impact Zh",
   "type": "string"
  },
  "message_zh": {
   "maxLength": 300,
   "minLength": 1,
   "title": "Message Zh",
   "type": "string"
  },
  "meta": {
   "anyOf": [
    {
     "$ref": "#/$defs/ProductMeta"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "next_action_zh": {
   "maxLength": 300,
   "minLength": 1,
   "title": "Next Action Zh",
   "type": "string"
  },
  "retry_after_seconds": {
   "anyOf": [
    {
     "minimum": 1,
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Retry After Seconds"
  },
  "sample": {
   "anyOf": [
    {
     "$ref": "#/$defs/SampleLabel"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "status": {
   "maximum": 599,
   "minimum": 400,
   "title": "Status",
   "type": "integer"
  },
  "support_ref": {
   "anyOf": [
    {
     "pattern": "^sup-[0-9a-f]{16}$",
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Support Ref"
  }
 },
 "required": [
  "status",
  "code",
  "message_zh",
  "impact_zh",
  "next_action_zh"
 ],
 "title": "ServiceError",
 "type": "object"
}
