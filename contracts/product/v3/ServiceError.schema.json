{
 "$defs": {
  "DataPackRef": {
   "additionalProperties": false,
   "description": "一份资料包的身份：编号、内容指纹与状态（合成测试资料，或冻结的真实资料包）。",
   "properties": {
    "content_fingerprint": {
     "pattern": "^[0-9a-f]{64}$",
     "title": "Content Fingerprint",
     "type": "string"
    },
    "note": {
     "maxLength": 400,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "pack_id": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$",
     "title": "Pack Id",
     "type": "string"
    },
    "status": {
     "enum": [
      "synthetic_fixture_only",
      "real_data_frozen"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "pack_id",
    "content_fingerprint",
    "status",
    "note"
   ],
   "title": "DataPackRef",
   "type": "object"
  },
  "DisplayAttachment": {
   "additionalProperties": false,
   "description": "即时回复（错误、确认结果）的显示附层：这类回复可能没有可以再读的对象，所以随回复一起给中英两种文字。\n``source_view_fingerprint`` 是去掉 ``display`` 之后的原回复的规范 JSON 摘要；``pointer`` 都相对那份原回复。",
   "properties": {
    "display_schema_version": {
     "const": "e3-display-v2",
     "title": "Display Schema Version",
     "type": "string"
    },
    "resource_version": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Resource Version"
    },
    "source_view_fingerprint": {
     "pattern": "^[0-9a-f]{64}$",
     "title": "Source View Fingerprint",
     "type": "string"
    },
    "translations": {
     "additionalProperties": {
      "$ref": "#/$defs/DisplayTranslation"
     },
     "propertyNames": {
      "enum": [
       "zh",
       "en"
      ]
     },
     "title": "Translations",
     "type": "object"
    }
   },
   "required": [
    "display_schema_version",
    "source_view_fingerprint",
    "translations"
   ],
   "title": "DisplayAttachment",
   "type": "object"
  },
  "DisplayField": {
   "additionalProperties": false,
   "description": "原消息里一个可展示文字位置的显示文字。``pointer`` 是相对原消息（或原回复）的 JSON Pointer，只指向含中文的业务说明文字——\n不指向数值、权重、编号、动作枚举、秘密，也不指向用户原文（用户原文保持原文，不翻译）。``key`` 是稳定的文案 / 实体键。",
   "properties": {
    "key": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Key",
     "type": "string"
    },
    "missing_reason": {
     "anyOf": [
      {
       "enum": [
        "no_binding",
        "translation_missing",
        "translation_stale",
        "source_changed",
        "ambiguous",
        "untranslated_param",
        "resources_unavailable",
        "resources_invalid",
        "binding_stale",
        "binding_unverified"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Missing Reason"
    },
    "pointer": {
     "maxLength": 400,
     "pattern": "^(/[^/]+)+$",
     "title": "Pointer",
     "type": "string"
    },
    "resource_version": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Resource Version"
    },
    "source_locale": {
     "enum": [
      "zh",
      "en"
     ],
     "title": "Source Locale",
     "type": "string"
    },
    "status": {
     "enum": [
      "provided",
      "missing"
     ],
     "title": "Status",
     "type": "string"
    },
    "text": {
     "anyOf": [
      {
       "maxLength": 6000,
       "minLength": 1,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Text"
    }
   },
   "required": [
    "pointer",
    "key",
    "status",
    "source_locale"
   ],
   "title": "DisplayField",
   "type": "object"
  },
  "DisplayTranslation": {
   "additionalProperties": false,
   "properties": {
    "fields": {
     "default": [],
     "items": {
      "$ref": "#/$defs/DisplayField"
     },
     "title": "Fields",
     "type": "array"
    },
    "status": {
     "enum": [
      "complete",
      "partial",
      "unavailable"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "status"
   ],
   "title": "DisplayTranslation",
   "type": "object"
  },
  "ProductMeta": {
   "additionalProperties": false,
   "description": "每条产品消息都带的共同元数据：结构、问卷、词表、健康问卷、转换的版本与资料包身份。",
   "properties": {
    "conversion_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Conversion Version",
     "type": "string"
    },
    "data_pack": {
     "$ref": "#/$defs/DataPackRef"
    },
    "health_questionnaire_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Health Questionnaire Version",
     "type": "string"
    },
    "questionnaire_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Questionnaire Version",
     "type": "string"
    },
    "sample": {
     "anyOf": [
      {
       "$ref": "#/$defs/SampleLabel"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "schema_version": {
     "const": "e3a-product-schema-v3.3",
     "title": "Schema Version",
     "type": "string"
    },
    "vocabulary_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Vocabulary Version",
     "type": "string"
    }
   },
   "required": [
    "schema_version",
    "questionnaire_version",
    "vocabulary_version",
    "health_questionnaire_version",
    "conversion_version",
    "data_pack"
   ],
   "title": "ProductMeta",
   "type": "object"
  },
  "SampleLabel": {
   "additionalProperties": false,
   "description": "公共样例的出处标签（只出现在样例里；真实运行的消息不写）。\n\n* ``offline_run``：由离线闭环实际执行产生；\n* ``controlled_fixture``：受控测试夹具（例如写好的计划、注入的事件、构造的资料缺口），标明来源；\n* ``contract_example``：线上服务（幂等提交、查询、断线恢复）尚未实现，这里只是**标明为示例**的契约响应。",
   "properties": {
    "note": {
     "maxLength": 600,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "origin": {
     "enum": [
      "offline_run",
      "controlled_fixture",
      "contract_example"
     ],
     "title": "Origin",
     "type": "string"
    },
    "produced_by": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Produced By",
     "type": "string"
    },
    "synthetic": {
     "const": true,
     "default": true,
     "title": "Synthetic",
     "type": "boolean"
    }
   },
   "required": [
    "origin",
    "produced_by",
    "note"
   ],
   "title": "SampleLabel",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "description": "统一的安全错误：机器代码、HTTP 状态与“发生了什么—影响是什么—下一步怎么做”的中文，加一个支持编号。不含用户输入、内部路径、\n堆栈、原始校验异常或秘密。",
 "properties": {
  "code": {
   "enum": [
    "unauthenticated",
    "not_found",
    "revision_conflict",
    "preflight_stale",
    "quota_exhausted",
    "idempotency_conflict",
    "intent_conflict",
    "not_resumable",
    "cancel_not_allowed",
    "result_unavailable",
    "deleting",
    "deleted",
    "expired",
    "data_pack_unavailable",
    "paid_calls_disabled",
    "run_options_invalid",
    "run_settings_unavailable",
    "rate_limited",
    "csrf_failed",
    "origin_rejected",
    "payload_too_large",
    "invalid_request",
    "internal_error"
   ],
   "title": "Code",
   "type": "string"
  },
  "display": {
   "anyOf": [
    {
     "$ref": "#/$defs/DisplayAttachment"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "field": {
   "anyOf": [
    {
     "enum": [
      "clones_per_city",
      "years",
      "max_cost_cny",
      "cities"
     ],
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Field"
  },
  "impact_zh": {
   "maxLength": 300,
   "minLength": 1,
   "title": "Impact Zh",
   "type": "string"
  },
  "message_zh": {
   "maxLength": 300,
   "minLength": 1,
   "title": "Message Zh",
   "type": "string"
  },
  "meta": {
   "anyOf": [
    {
     "$ref": "#/$defs/ProductMeta"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "next_action_zh": {
   "maxLength": 300,
   "minLength": 1,
   "title": "Next Action Zh",
   "type": "string"
  },
  "retry_after_seconds": {
   "anyOf": [
    {
     "minimum": 1,
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Retry After Seconds"
  },
  "sample": {
   "anyOf": [
    {
     "$ref": "#/$defs/SampleLabel"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "status": {
   "maximum": 599,
   "minimum": 400,
   "title": "Status",
   "type": "integer"
  },
  "support_ref": {
   "anyOf": [
    {
     "pattern": "^sup-[0-9a-f]{16}$",
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Support Ref"
  }
 },
 "required": [
  "status",
  "code",
  "message_zh",
  "impact_zh",
  "next_action_zh"
 ],
 "title": "ServiceError",
 "type": "object"
}
