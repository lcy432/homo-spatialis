{
 "$defs": {
  "DataPackRef": {
   "additionalProperties": false,
   "description": "一份资料包的身份：编号与内容指纹。本轮只有合成资料包（``synthetic_fixture_only``）。",
   "properties": {
    "content_fingerprint": {
     "pattern": "^[0-9a-f]{64}$",
     "title": "Content Fingerprint",
     "type": "string"
    },
    "note": {
     "maxLength": 400,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "pack_id": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-/]{0,127}$",
     "title": "Pack Id",
     "type": "string"
    },
    "status": {
     "enum": [
      "synthetic_fixture_only",
      "real_data_frozen"
     ],
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "pack_id",
    "content_fingerprint",
    "status",
    "note"
   ],
   "title": "DataPackRef",
   "type": "object"
  },
  "ProductIssue": {
   "additionalProperties": false,
   "description": "一条可展示的问题：机器代码、字段位置、中文原因、影响与下一步动作。E5 原样展示中文，不另写解释。",
   "properties": {
    "audit_ref": {
     "anyOf": [
      {
       "maxLength": 200,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Audit Ref"
    },
    "code": {
     "pattern": "^[a-z][a-z0-9_]{1,63}$",
     "title": "Code",
     "type": "string"
    },
    "field": {
     "maxLength": 160,
     "minLength": 1,
     "title": "Field",
     "type": "string"
    },
    "impact_zh": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Impact Zh",
     "type": "string"
    },
    "message_zh": {
     "maxLength": 400,
     "minLength": 1,
     "title": "Message Zh",
     "type": "string"
    },
    "next_action_zh": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Next Action Zh",
     "type": "string"
    },
    "severity": {
     "enum": [
      "error",
      "warning",
      "info"
     ],
     "title": "Severity",
     "type": "string"
    }
   },
   "required": [
    "code",
    "severity",
    "field",
    "message_zh",
    "impact_zh",
    "next_action_zh"
   ],
   "title": "ProductIssue",
   "type": "object"
  },
  "ProductMeta": {
   "additionalProperties": false,
   "description": "每条产品消息都带的共同元数据：结构、问卷、词表、健康问卷、转换的版本与资料包身份。",
   "properties": {
    "conversion_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Conversion Version",
     "type": "string"
    },
    "data_pack": {
     "$ref": "#/$defs/DataPackRef"
    },
    "health_questionnaire_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Health Questionnaire Version",
     "type": "string"
    },
    "questionnaire_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Questionnaire Version",
     "type": "string"
    },
    "sample": {
     "anyOf": [
      {
       "$ref": "#/$defs/SampleLabel"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "schema_version": {
     "const": "e3a-product-schema-v2",
     "title": "Schema Version",
     "type": "string"
    },
    "vocabulary_version": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Vocabulary Version",
     "type": "string"
    }
   },
   "required": [
    "schema_version",
    "questionnaire_version",
    "vocabulary_version",
    "health_questionnaire_version",
    "conversion_version",
    "data_pack"
   ],
   "title": "ProductMeta",
   "type": "object"
  },
  "SampleLabel": {
   "additionalProperties": false,
   "description": "公共样例的出处标签（只出现在样例里；真实运行的消息不写）。\n\n* ``offline_run``：由离线闭环实际执行产生；\n* ``controlled_fixture``：受控测试夹具（例如写好的计划、注入的事件、构造的资料缺口），标明来源；\n* ``contract_example``：线上服务（幂等提交、查询、断线恢复）尚未实现，这里只是**标明为示例**的契约响应。",
   "properties": {
    "note": {
     "maxLength": 600,
     "minLength": 1,
     "title": "Note",
     "type": "string"
    },
    "origin": {
     "enum": [
      "offline_run",
      "controlled_fixture",
      "contract_example"
     ],
     "title": "Origin",
     "type": "string"
    },
    "produced_by": {
     "maxLength": 300,
     "minLength": 1,
     "title": "Produced By",
     "type": "string"
    },
    "synthetic": {
     "const": true,
     "default": true,
     "title": "Synthetic",
     "type": "boolean"
    }
   },
   "required": [
    "origin",
    "produced_by",
    "note"
   ],
   "title": "SampleLabel",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "description": "提交回执：接受、重复提交（返回原运行 ID，不再生成新的一批分身）或拒绝（附原因）。",
 "properties": {
  "idempotency_key": {
   "title": "Idempotency Key",
   "type": "string"
  },
  "meta": {
   "$ref": "#/$defs/ProductMeta"
  },
  "reasons": {
   "default": [],
   "items": {
    "$ref": "#/$defs/ProductIssue"
   },
   "title": "Reasons",
   "type": "array"
  },
  "run_id": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Run Id"
  },
  "service": {
   "enum": [
    "offline_bridge",
    "contract_example_only"
   ],
   "title": "Service",
   "type": "string"
  },
  "status": {
   "enum": [
    "accepted",
    "duplicate_same_run",
    "rejected"
   ],
   "title": "Status",
   "type": "string"
  }
 },
 "required": [
  "meta",
  "status",
  "idempotency_key",
  "service"
 ],
 "title": "RunReceipt",
 "type": "object"
}
