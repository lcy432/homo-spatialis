 "assumptions": [
  {
   "id": "food_energy_completion_v1",
   "nature": "rule",
   "statement_zh": "篮子每周热量不够参照量时，差额按 complement 篮子（主食为主）每千卡的花费补上；够了不补不缩",
   "basis_zh": "intake 的篮子只是“这类做法的代表食材”，不是一个人一周吃的全部；补齐后才能声明覆盖整月基本饮食。不是营养方案",
   "config": "life-items-us-v1"
  },
  {
   "id": "food_energy_reference_v1",
   "nature": "assumption",
   "value": "每人每天 2,000 千卡（每周 14,000）",
   "basis_zh": "美国食品标签的参照热量（FDA 营养成分表“2,000 calories a day is used for general nutrition advice”）；只作“吃饱的量”，不是营养声明",
   "config": "life-items-us-v1"
  },
  {
   "id": "ap_item_energy_match_v1",
   "nature": "assumption",
   "statement_zh": "每种 BLS AP 食材对应一条 USDA SR Legacy 条目（见 food.item_energy），按购买重量算热量",
   "basis_zh": "资料里的能量（nutrient 1008，千卡/100 克）与份量克重；对应关系是本配置写定的；不扣骨头、果皮等不可食部分（FDC 的 CSV 没有可食比例），所以整鸡、香蕉、橙子、草莓、生菜、番茄的热量偏高、补齐的主食偏少",
   "config": "life-items-us-v1"
  },
  {
   "id": "food_plan_composition_v1",
   "nature": "assumption",
   "statement_zh": "三个篮子各自的每周新鲜餐数（主食为主 4、荤素搭配 10、鲜肉蔬果较多 17，按 21 餐计）与每顿做饭分钟（20、25、30），见 food.plan_baskets；所有方案共用",
   "basis_zh": "篮子是“主食为主 / 荤素搭配 / 鲜肉蔬果较多”的设定，新鲜餐数按篮子里生鲜食材的多少写定；量级核对：BLS ATUS 2025 年平均，做饭的人每天花 1.09 小时在做饭与收拾上（见 food_time_check_v1）",
   "config": "life-items-us-v1"
  },
  {
   "id": "food_shopping_hours_v1",
   "nature": "assumption",
   "value": "买菜每周 2 小时",
   "basis_zh": "BLS ATUS 2025 年平均，购物的人每天 0.87 小时购买消费品（不只是食品）；只作量级",
   "config": "life-items-us-v1"
  },
  {
   "id": "food_home_share_by_meals_v1",
   "nature": "rule",
   "statement_zh": "方案里家里部分的费用 = 同一篮子补齐后的一周费用 × 家里餐数 ÷ 21；家里餐数取共同网格 0、3、7、14、21",
   "config": "life-items-us-v1"
  },
  {
   "id": "food_fresh_by_basket_share_v1",
   "nature": "rule",
   "statement_zh": "每个组成的新鲜餐 = 这一组成的每周餐数 × 篮子新鲜餐数 ÷ 21（家里与外面同一比例），四舍五入到 0.01；外食与外送不自动算新鲜",
   "basis_zh": "外食的食材口径就是所用篮子（food_away_cost_proxy_v1），新鲜程度跟着篮子走；没有餐馆新鲜度资料",
   "config": "life-items-us-v1"
  },
  {
   "id": "food_away_cost_proxy_v1",
   "nature": "assumption",
   "statement_zh": "外食一顿 = 所用篮子补齐后每周花费 ÷ 21 + 厨房 0.25 小时 × 厨师（35-2014）都会区中位时薪 × 人工费用倍率 2.0 + 场地及其他 2 美元（全国基准）× 其他服务 RPP ÷ 100；外送每顿再加 0.2 小时 × 配送司机（53-3033）中位时薪 × 2.0",
   "basis_zh": "共同探索假设，六城同一公式，城市差异只来自食材价、工资与 RPP；不是已验证的菜单价。销售税、平台费与小费没有单列，不另加（机会属性 taxes_fees_tips = not_itemized）。CE 都会区的在外饮食支出只做量级对照（food_check）",
   "config": "life-items-us-v1"
  },
  {
   "id": "dining_hours_v1",
   "nature": "assumption",
   "value": "外食每顿 1.25 小时（含往返），外送每顿 0.25 小时（下单与收取）",
   "config": "life-items-us-v1"
  },
  {
   "id": "cuisine_evidence_threshold_v2",
   "nature": "assumption",
   "value": "本城至少 20 家 OSM restaurant 写了这个菜系标签才算“有供应证据”；只用来标明证据，不再决定提供与否，也不截取前几名",
   "basis_zh": "家数只说明存在，不说明质量或价格；OSM 的覆盖不完整",
   "config": "life-items-us-v1"
  },
  {
   "id": "food_cuisine_common_availability_v1",
   "nature": "assumption",
   "statement_zh": "产品资料包外食菜系词表里的 9 个菜系在六个都会区都按共同可得提供；本城 OSM 不到证据门槛的方案在机会里标明（cuisine_supply_evidence = common_availability_assumed），不冒充某家餐馆的报价",
   "basis_zh": "OSM 未发现只表示缺少供应证据，不等于买不到；用同一个成本代理计价，不制造城市差异",
   "config": "life-items-us-v1"
  },
  {
   "id": "retail_correction_lognormal_v1",
   "nature": "assumption",
   "statement_zh": "同规格零售价相对基础成本预测的修正 δ = log(实际价 ÷ 基础预测价)，共同先验 N(0, log(1.5)²)；同规格直接报价按供应商去重、每家一个对数比值；本地均值观测方差 max(s²/n, log(1.1)²)，只有一家时 log(1.5)²；正态共轭更新，执行价 = 基础预测 × exp(后验均值)",
   "basis_zh": "方差是登记的探索设定，不是从报价估计的；现在六城没有合格的同规格直接报价，所以全部“未发生本地报价更新”，执行价就是基础预测（标为估计）",
   "config": "life-items-us-v1"
  },
  {
   "id": "daily_support_cost_order_v1",
   "nature": "rule",
   "statement_zh": "日常支持的费用顺序：同规格直接报价 → FCC 同规格大区参照（家庭宽带，大区至少 30 条同规格报价）→ FCC 全国参照 → CE 一人消费单位预算代理；现在六城都没有直接报价",
   "config": "life-items-us-v1"
  },
  {
   "id": "ce_one_person_budget_proxy_v1",
   "nature": "assumption",
   "statement_zh": "手机通信月费 = CE 2024 一人消费单位手机服务年均支出 ÷ 12（共同预算代理，各城相同）；不是单人套餐报价，不能把全部家庭的通信支出叫单人套餐价",
   "basis_zh": "没有可用的单人套餐直接报价；CE 是全国一人消费单位的平均支出，含不同套餐与使用量",
   "config": "life-items-us-v1"
  },
  {
   "id": "fcc_broadband_basic_tier_v1",
   "nature": "assumption",
   "statement_zh": "家庭宽带基本档 = FCC 2024 城市费率调查里下行 100–199 Mbps、上行至少 20 Mbps、不限流量的报价；参照价 = 本城所在人口普查大区这些报价按调查权重的中位数总月费（月费 + 强制收费 + 附加费，不含税），按 CPI 互联网服务（CUUR0000SEEE03）2024 ÷ 2023 年平均换到 2024 年",
   "basis_zh": "100/20 是 FCC 2024 年的宽带速度定义；只取这一档是因为更快的套餐不另加分（所有达到 100/20 的套餐的中位数高约一半）；URS 2024 是 2023 年调查的价格（抽样框为 2022 年 12 月的资料，2023 年 12 月发布），具体调查月份没有核到，按年平均换算",
   "config": "life-items-us-v1"
  },
  {
   "id": "household_supplies_ce_v1",
   "nature": "assumption",
   "statement_zh": "家用日耗品月费 = CE 2024 一人消费单位（洗衣清洁用品 + 其他家用品里纸品与杂项的分配额）÷ 12 × 本城商品类 RPP ÷ 100；草坪园艺用品与邮资文具不算",
   "basis_zh": "一人表的“其他家用品”没有细项：按全国详细表的子项占比拆分（分配估计）",
   "config": "life-items-us-v1"
  },
  {
   "id": "basic_device_access_v1",
   "nature": "assumption",
   "statement_zh": "基本终端（能用的手机与电脑）是所有分身一致的使用条件：不买、不计财富、不计享受、不进期末资产；本轮只模拟服务接入与日耗品",
   "config": "life-items-us-v1"
  },
  {
   "id": "consumption_basket_ce_v1",
   "nature": "assumption",
   "statement_zh": "标准个人消费篮子 = CE 2024 一人消费单位白名单条目（16 岁以上男女衣着、成人鞋履、首饰手表、衣着修补租赁存放、个人护理产品与服务）的月均构成 e_j；P_c = Σ e_j × 价格系数（商品 → 商品类 RPP，服务 → 其他服务 RPP）；档位 u ∈ {0.25, 0.5, 1, 1.5, 2, 3, 4}，费用 u × P_c",
   "basis_zh": "固定构成的粗粒度成本模型，不是从城市居民支出识别出的零售价；一人表缺细分类时按全国详细表的子项占比拆分（分配估计）；各城 CE 均值只做外部对照，不改个人偏好或制造城市享受优势",
   "config": "life-items-us-v1"
  },
  {
   "id": "home_style_cuisine_v1",
   "nature": "assumption",
   "statement_zh": "自己做的饭菜系按“家常”（home_style）计",
   "config": "life-items-us-v1"
  },
  {
   "id": "food_prep_burden_v1",
   "nature": "assumption",
   "value": "食品方案每小时负担 0.5",
   "basis_zh": "与合成样例的做饭负担相同；负担是 E1 的合成尺度，不能测量",
   "config": "life-items-us-v1"
  },
  {
   "id": "oews_hourly_from_annual_v1",
   "nature": "rule",
   "statement_zh": "时薪 = OEWS 年薪 ÷ 2,080（OEWS 对按小时计酬职业的年薪就是时薪 × 2,080）",
   "config": "life-items-us-v1"
  },
  {
   "id": "labor_overhead_v1",
   "nature": "assumption",
   "value": "服务价格 = 工人工资 × 2.0",
   "basis_zh": "倍率覆盖雇主的福利与税费、交通、用品、管理与利润；没有本地服务价格资料，倍率是量级设定",
   "config": "life-items-us-v1"
  },
  {
   "id": "service_hours_v1",
   "nature": "assumption",
   "statement_zh": "每项服务的工人小时、本人小时与替代后残余家务小时（services.chores / enjoyment）",
   "basis_zh": "量级设定，与合成样例的残余写法相同（洗衣服务残余 2 小时）；协议的家务基准由资料包定，残余不能超过基准",
   "config": "life-items-us-v1"
  },
  {
   "id": "device_category_v1",
   "nature": "assumption",
   "statement_zh": "设备类别的全国价格、寿命与替代后残余（devices.offers）；价格 × intake 的商品类空间换算系数",
   "basis_zh": "ENERGY STAR 不记价格、寿命与效果；这些是类别设定，不是型号报价；同一类别的型号价格相同",
   "config": "life-items-us-v1"
  },
  {
   "id": "device_failure_v1",
   "nature": "assumption",
   "statement_zh": "每个设备类别与爱好装备 3 年内不建模随机故障（none_within_horizon），见 devices.failure 与 equipment[].failure；写进机会的 failure（FailureSpec）",
   "basis_zh": "没有公开的故障率资料；保修条款不是故障分布",
   "config": "life-items-us-v1"
  },
  {
   "id": "device_installable_v1",
   "nature": "assumption",
   "statement_zh": "设备按“住处可以安装”设定",
   "basis_zh": "住房资料没有洗衣机接口与排风条件；这是缺口，不是事实",
   "config": "life-items-us-v1"
  },
  {
   "id": "equipment_category_v1",
   "nature": "assumption",
   "statement_zh": "爱好装备的全国价格与寿命（equipment）× 商品类空间换算系数",
   "config": "life-items-us-v1"
  },
  {
   "id": "activity_template_v1",
   "nature": "assumption",
   "statement_zh": "模型活动的老师小时、人数、场地与器材设定（activities.templates）；场地设定 × RPP 总水平 ÷ 100",
   "basis_zh": "只在本城 OSM 看得到相应场所时提供；标成模型方案，不是某个场所的真实报价",
   "config": "life-items-us-v1"
